# Copy to .env.local and fill in. Server-side only; never prefix with NEXT_PUBLIC_.

# Optional. Fine-grained GitHub token, read-only: Metadata, Issues, Pull
# requests, Actions and Deployments (read) on the GITHUB_OWNERS repos. Without
# it the GitHub-backed views show "source down".
GITHUB_TOKEN=
# Comma list of GitHub users or orgs whose repos the dashboard reads. No
# default: without it the GitHub-backed views show "source down".
# GITHUB_OWNERS=octo-org,octo-labs
GITHUB_OWNERS=
# Comma list of GitHub logins trusted to name an agent with the 🤖 header,
# usually the agents' shared bot account and the owner. Unset trusts nobody,
# so every PR and claim shows as unattributed.
# GITHUB_TRUSTED_AUTHORS=octo-bot,octocat
GITHUB_TRUSTED_AUTHORS=

# Buzz relay and a dedicated read-only Buzz identity.
BUZZ_RELAY_URL=wss://relay.example
# 64-char hex private key.
BUZZ_PRIVATE_KEY=
# Optional NIP-OA owner attestation JSON, needed when the identity is not a
# relay member: ["auth","<owner-hex>","<conditions>","<sig>"]
BUZZ_AUTH_TAG=
# Hex pubkey of the agents' owner. Only profiles carrying this owner's valid
# NIP-OA attestation count as agents. Defaults to the owner in BUZZ_AUTH_TAG.
BUZZ_OWNER_PUBKEY=

# Optional owner sign-in for the dashboard's own writes (snooze/ack, alerts,
# sources). Unset is off. "nostr": a NIP-07 extension signs in, and the
# allowed keys are BUZZ_OWNER_PUBKEY (a comma list is allowed). It also needs
# AUTH_PUBLIC_URL, the URL you open the dashboard at. "proxy": trust
# AUTH_PROXY_HEADER, only when the request carries AUTH_PROXY_SECRET in
# X-Buzz-Proxy-Secret. AUTH_PROXY_USERS optionally limits who is the owner.
AUTH_MODE=
AUTH_PUBLIC_URL=
AUTH_PROXY_HEADER=
AUTH_PROXY_SECRET=
AUTH_PROXY_USERS=
# Put every page and API read behind that sign-in too (1 to turn on). Off by
# default. With it on and AUTH_MODE unset, nobody gets in.
REQUIRE_SIGN_IN_FOR_READS=

# Media tab: the public R2 bucket your uploader writes to. Optional; without
# these the Media tab shows "source down". Use an R2 API token scoped to
# Object Read only on this one bucket.
MEDIA_BASE_URL=https://media.example
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Renamed agents, as JSON of former → current display name. An old
# profile folds into the current name and /agents/<old-name> redirects.
# AGENT_ALIASES={"Fizz":"Prime","Comb":"Shockwave"}
AGENT_ALIASES=

# Optional. Comma list of labels to leave off the Needs-you card. merge-ready
# PRs show there by default; set it to merge-ready if a merge bot handles them.
NEEDS_YOU_EXCLUDE_LABELS=

# Optional history store (#39): Postgres for the history views. Unset keeps
# the live-only dashboard with the history views hidden. Migrations run on
# start. For `pnpm dev` with `docker compose up -d postgres`:
# DATABASE_URL=postgres://hive:hive@127.0.0.1:5432/hive
# Inside compose, the dashboard reaches it as postgres:5432 instead.
DATABASE_URL=
# Days of history to keep. Default 90.
HISTORY_RETENTION_DAYS=

# "Today" on the Agents and Timeline views follows the server clock.
# TZ=America/Toronto
